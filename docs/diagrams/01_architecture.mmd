flowchart TB
  subgraph PC1["PC 1 - Sender"]
    direction TB
    B1["Browser Dashboard"] -->|"HTTP 127.0.0.1:8000 + token"| W1["Flask Web API (localhost only)"]
    W1 --> D1["Discovery: UDP beacons + subnet scan"]
    W1 --> TM1["Transfer Manager (client)"]
    TM1 --> C1["Crypto Engine: X25519 / Ed25519 / HKDF / AES-256-GCM"]
