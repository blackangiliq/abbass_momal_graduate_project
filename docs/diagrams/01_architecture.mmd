  end
  subgraph PC2["PC 2 - Receiver"]
    direction TB
    D2["Discovery: UDP beacons + subnet scan"]
    TM2["Transfer Manager (TCP server :5001)"]
    TM2 --> C2["Crypto Engine: X25519 / Ed25519 / HKDF / AES-256-GCM"]
    C2 --- K2[("identity key + Received folder")]
    W2["Flask Web API (localhost only)"] --> D2
    W2 --> TM2
    B2["Browser Dashboard"] -->|"HTTP 127.0.0.1:8000 + token"| W2
  end
  D1 <-.->|"UDP 50505 broadcast - public info only"| D2
